{
  "name": "poe2merchanthistory",
  "private": true,
  "type": "module",
  "version": "0.2.0",
  "scripts": {
    "lint:eslint": "eslint playwright.config.js src/**/*.ts tests/**/*.js",
    "lint:style": "stylelint public/**/*.css",
    "typecheck": "tsc --noEmit",
    "build:ts": "tsc -p tsconfig.json",
    "build": "vite build",
    "test:unit": "npm run build:ts && node --test tests/unit/*.test.js",
    "format:check": "prettier --check \"**/*.{js,ts,css,html,json,md,yml,mjs}\"",
    "format": "prettier --write \"**/*.{js,ts,css,html,json,md,yml,mjs}\"",
    "lint": "npm run lint:eslint && npm run lint:style && npm run typecheck && npm run format:check",
    "setup:browsers": "playwright install --with-deps chromium",
    "test:e2e": "playwright test",
    "test:e2e:extension": "playwright test tests/e2e/extension-core.spec.js"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@types/chrome": "^0.1.27",
    "@typescript-eslint/eslint-plugin": "^8.24.0",
    "@typescript-eslint/parser": "^8.24.0",
    "eslint": "^8.57.0",
    "prettier": "^3.2.5",
    "stylelint": "^16.5.0",
    "stylelint-config-standard": "^36.0.0",
    "typescript": "^5.9.2",
    "vite": "^6.1.1"
  }
}
